---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  draft?: boolean;
}

const {
  title,
  description = 'Thoughts on networking, tech, and movies by Kyle Stanfield.',
  ogImage = '/static/Blog.png',
  draft = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en-us">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Kyle Stanfield" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="canonical" href={canonical} />
    {draft && <meta name="robots" content="noindex, nofollow" />}
    <link rel="stylesheet" href="/static/style.css" />
    <link rel="alternate" type="application/rss+xml" title="Kyle's Blog" href="/rss.xml" />
    {import.meta.env.PROD && <>
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-5G7758GHBT"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-5G7758GHBT');
      </script>
    </>}
  </head>
  <body>
    <div class="site clearfix">
      <div class="title"><h1><a href="/">Kyle's Blog</a></h1></div>
      <div class="main-content-area">
        <main id="post"><slot /></main>
      </div>
      <div id="related"><slot name="related" /></div>
      <footer class="footer">
        <div class="contact">
          <p>Kyle Stanfield</p>
          <p>
            <a rel="me" href="https://github.com/kylestanfield">GitHub</a>
            &nbsp;&middot;&nbsp;<a rel="me" href="https://www.linkedin.com/in/kylejstanfield/">LinkedIn</a>
            &nbsp;&middot;&nbsp;<a href="/rss.xml">RSS</a>
          </p>
        </div>
        <div class="license">
          This work is licensed under the <a href="https://opensource.org/licenses/MIT">MIT License</a>.
          &nbsp;&middot;&nbsp;<a href="/ryu/privacy-policy/">Ryu Privacy Policy</a>
          &nbsp;&middot;&nbsp;<a href="/japanese-news-dark-mode/support/">Japanese News Dark Mode Support</a>
          &nbsp;&middot;&nbsp;<a href="/japanese-news-dark-mode/privacy/">Japanese News Dark Mode Privacy</a>
        </div>
      </footer>
    </div>
  </body>
</html>
