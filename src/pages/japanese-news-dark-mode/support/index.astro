<BaseLayout title="Japanese News Dark Mode — Support">
<style is:global>
    .support h2 { margin-top: 1.6em; }
    .support p, .support ul { padding-left: 0.5em; }
    .support ul li { line-height: 1.7em; margin-bottom: 0.4em; }
    .about { display: none; }
